# Settings for deploy/docker-compose.yml. Copy this file to deploy/.env and fill it in.
# See docs/deployment.md.

# Password of the database user. Make it long; avoid ; and quotes, which the connection string cannot hold.
POSTGRES_PASSWORD=change-me-to-something-long

# The address people and agents use to reach Argus. It appears in the agents' install commands.
ARGUS_PUBLIC_URL=https://argus.example.com

# Where the server listens on this machine. With Caddy in front, keep it private: 127.0.0.1:8080
ARGUS_HTTP_BIND=8080

# Let anyone who can reach Argus create an account. The first account is set up in the browser either way.
ARGUS_ALLOW_REGISTRATION=false

# Optional: HTTPS with Caddy. Point the domain's DNS at this machine, set it here, and switch the
# profile on by uncommenting COMPOSE_PROFILES.
ARGUS_DOMAIN=argus.example.com
# COMPOSE_PROFILES=caddy
