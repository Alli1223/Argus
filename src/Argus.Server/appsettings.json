{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Npgsql": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Argus": {
    "PublicUrl": null,
    "Auth": {
      "AllowRegistration": false
    },
    "Database": {
      "MigrateOnStartup": true,
      "StartupRetries": 30
    },
    "Agents": {
      "CollectionIntervalSeconds": 15,
      "InventoryIntervalMinutes": 60,
      "TopProcessCount": 10,
      "OfflineAfterSeconds": 90
    },
    "Alerts": {
      "EvaluationIntervalSeconds": 30,
      "BackgroundEvaluation": true
    },
    "Ingest": {
      "MaxSampleAgeHours": 72,
      "MaxClockSkewSeconds": 300
    },
    "Retention": {
      "RawDays": 14,
      "FiveMinuteDays": 90,
      "HourlyDays": 730
    },
    "RateLimits": {
      "AuthPermitsPerMinute": 10,
      "AgentRegisterPermitsPerMinute": 60,
      "AgentIngestPermitsPerMinute": 120
    },
    "Proxy": {
      "TrustedProxies": [],
      "TrustedNetworks": []
    }
  }
}
